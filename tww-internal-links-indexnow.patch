diff --git a/scripts/submit-indexnow.mjs b/scripts/submit-indexnow.mjs
new file mode 100644
index 0000000..47e961a
--- /dev/null
+++ b/scripts/submit-indexnow.mjs
@@ -0,0 +1,16 @@
+// Usage: node scripts/submit-indexnow.mjs [url ...]
+// With no arguments, submits every URL in public/sitemap.xml.
+import { readFileSync } from 'node:fs';
+const HOST = 'www.techworldwindow.com';
+const KEY = '7e4f599b78533bfe29aa94634833993e';
+let urls = process.argv.slice(2);
+if (!urls.length) {
+  const xml = readFileSync(new URL('../public/sitemap.xml', import.meta.url), 'utf8');
+  urls = [...xml.matchAll(/<loc>(.*?)<\/loc>/g)].map((m) => m[1]);
+}
+const res = await fetch('https://api.indexnow.org/indexnow', {
+  method: 'POST',
+  headers: { 'Content-Type': 'application/json; charset=utf-8' },
+  body: JSON.stringify({ host: HOST, key: KEY, keyLocation: `https://${HOST}/${KEY}.txt`, urlList: urls }),
+});
+console.log(`IndexNow: ${urls.length} URLs, HTTP ${res.status}`);
