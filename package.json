{
  "name": "tech-world-window",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite-react-ssg dev",
    "dev:csr": "vite",
    "typecheck": "tsc --noEmit",
    "generate:sitemap": "tsx scripts/generate-sitemap.ts",
    "generate:rss": "tsx scripts/generate-rss.ts",
    "validate": "tsx scripts/validate-build.ts",
    "build": "npm run generate:sitemap && npm run generate:rss && npm run typecheck && vite-react-ssg build && npm run validate",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^6.4.0",
    "vite-react-ssg": "^0.9.2",
    "@types/node": "^24.0.0"
  }
}
