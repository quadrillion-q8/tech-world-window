{
  "name": "tech-world-window",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "predev": "npm run generate:article-data",
    "dev": "vite-react-ssg dev",
    "predev:csr": "npm run generate:article-data",
    "dev:csr": "vite",
    "generate:article-data": "tsx scripts/generate-article-data.ts",
    "pretypecheck": "npm run generate:article-data",
    "typecheck": "tsc --noEmit",
    "generate:sitemap": "tsx scripts/generate-sitemap.ts",
    "generate:rss": "tsx scripts/generate-rss.ts",
    "validate:content": "tsx scripts/audit-content-integrity.ts",
    "audit:gallery": "tsx scripts/audit-gallery-coverage.ts",
    "validate": "tsx scripts/validate-build.ts && npm run validate:content && npm run audit:gallery && npm run audit:links && npm run audit:frame-time && npm run audit:lifecycle",
    "build": "npm run generate:sitemap && npm run generate:rss && npm run typecheck && vite-react-ssg build && npm run validate",
    "preview": "vite preview",
    "audit:links": "tsx scripts/audit-link-topology.ts",
    "audit:frame-time": "tsx scripts/audit-frame-time.ts",
    "audit:lifecycle": "tsx scripts/audit-windows-lifecycle.ts",
    "report:bundle": "node scripts/report-bundle-sizes.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^6.4.0",
    "vite-react-ssg": "^0.9.2",
    "@types/node": "^24.0.0"
  }
}